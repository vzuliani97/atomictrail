# `make .env` copies this file and replaces every replace-with-... value with a random secret.
# The API refuses to start with a placeholder. .env is git-ignored.
POSTGRES_PASSWORD=paypoint_local_password
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# Password for the demo users admin@paypoint.local and cajero@paypoint.local
DEMO_PASSWORD=paypoint-demo
# HMAC secret for the demo integrator (api key: pk_demo_tienda_centro)
DEMO_PARTNER_SECRET=replace-with-a-random-secret
# HMAC secret of the simulated casino game provider (wallet callbacks)
CASINO_PROVIDER_SECRET=replace-with-a-random-secret
